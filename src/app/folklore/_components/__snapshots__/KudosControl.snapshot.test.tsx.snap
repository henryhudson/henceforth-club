// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`KudosControl > renders a visitor's control disabled with the one-line £2 nudge 1`] = `"<button type="button" disabled="" aria-label="give kudos" title="Open your archive to get kudos — the £2 becomes your float." class="font-mono text-xs text-muted transition-colors enabled:hover:text-accent enabled:active:scale-95 disabled:opacity-60">✦ kudos</button>"`;

exports[`KudosControl > renders ready with the public count — one tappable control, no vote button 1`] = `"<button type="button" aria-label="give kudos" class="font-mono text-xs text-muted transition-colors enabled:hover:text-accent enabled:active:scale-95 disabled:opacity-60">✦ kudos<span class="text-accent"> · 12</span></button>"`;

exports[`the control on text rows and single-post pages > shows the public count on a single post row 1`] = `"<article id="post-1" data-post-id="1" class="px-1 py-4"><div class="flex items-start gap-3"><div class="min-w-0 flex-1"><p class="mb-1 text-sm leading-tight"><a class="group/name" href="/folklore/someone"> <span class="text-muted">@someone</span></a></p><button type="button" aria-expanded="false" aria-controls="_R_0_" class="group flex w-full min-w-0 items-start gap-3 text-left"><p class="min-w-0 flex-1 whitespace-pre-wrap text-base leading-loose text-foreground transition-colors group-hover:text-accent">First.</p><span aria-hidden="true" class="mt-1 shrink-0 select-none font-mono text-sm text-muted transition-colors group-hover:text-accent">+</span></button></div></div><p class="mt-3 flex flex-wrap items-center gap-x-2 text-xs text-muted"><span>2 Sept 2012</span><span aria-hidden="true">·</span><button type="button" disabled="" aria-label="give kudos to this text by @someone" class="font-mono text-xs text-muted transition-colors enabled:hover:text-accent enabled:active:scale-95 disabled:opacity-60">✦ kudos<span class="text-accent"> · 7</span></button></p></article>"`;
