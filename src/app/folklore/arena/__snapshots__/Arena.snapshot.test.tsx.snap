exports[`ArenaView > shows a visitor the disabled state with the £2 nudge 1`] = `"<div class="mx-auto max-w-[68ch] px-6 py-10"><p class="ledger-label mb-1">the arena · two texts, dealt</p><p class="mb-6 text-xs text-muted">Give kudos to the one you prefer — the first kudos crowns it, and every further tap in the beat goes to the winner.</p><div class="rounded-lg border border-card-border bg-card-bg px-5 py-6"><p class="text-sm text-foreground">The arena runs on kudos, and kudos come with an archive.</p><p class="mt-2 text-sm text-muted">Open your archive to get kudos — the £2 becomes your float.</p><a class="mt-4 inline-block font-mono text-sm text-accent hover:underline" href="/folklore">open your archive →</a></div></div>"`;

exports[`ArenaView > stacks the dealt pair with the shared kudos control on each text and NO vote buttons 1`] = `"<div class="mx-auto max-w-[68ch] px-6 py-10"><p class="ledger-label mb-1">the arena · two texts, dealt</p><p class="mb-6 text-xs text-muted">Give kudos to the one you prefer — the first kudos crowns it, and every further tap in the beat goes to the winner.</p><div class="space-y-4"><article class="rounded-lg border border-card-border bg-card-bg px-5 py-5"><p class="mb-2 text-xs text-muted"><a class="hover:text-accent" href="/folklore/ann">@ann</a></p><p class="whitespace-pre-wrap text-base leading-loose text-foreground">The first text, dealt on top.</p><div class="mt-3"><button type="button" aria-label="give kudos to @ann" class="font-mono text-xs text-muted transition-colors enabled:hover:text-accent enabled:active:scale-95 disabled:opacity-60">✦ kudos</button></div></article><article class="rounded-lg border border-card-border bg-card-bg px-5 py-5"><p class="mb-2 text-xs text-muted"><a class="hover:text-accent" href="/folklore/ben">@ben</a></p><p class="whitespace-pre-wrap text-base leading-loose text-foreground">The second text, stacked beneath.</p><div class="mt-3"><button type="button" aria-label="give kudos to @ben" class="font-mono text-xs text-muted transition-colors enabled:hover:text-accent enabled:active:scale-95 disabled:opacity-60">✦ kudos</button></div></article></div><p aria-live="polite" class="pointer-events-none fixed bottom-4 right-4 z-40 font-mono text-[11px] text-muted">float <span class="text-accent">1,997</span></p></div>"`;
