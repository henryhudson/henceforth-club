# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings
.claude/

# Superpowers brainstorm artifacts (visual companion mockups)
.superpowers/

# Local-only working files (assets + research scratchpads, never shipped)
marketing/
src/app/scriptedsupply/RESEARCH-NOTES.md

# Generated video assets (see scripts/render-hansard-video.sh)
scripts/.frames/
scripts/anthem.oga
scripts/hansard-anthem.mp4

# private Morning Board data (served from a private store in prod, not committed)
content/board/
.env*.local

# private worker key files (fund-linked, live only on the worker's disk, never committed)
scripts/xtext-worker/jobs/

# This Week draft review PDFs (scripts/this-week/render-draft.mjs) — local only
scripts/this-week/preview/

# Founding-correction artifacts — production ledger snapshots and reviewed
# plans, never committed (the repo is public).
ledger-backup-*.json
plan-founding-*.json
